{
  "name": "five-cent-life-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "五毛钱人生仪表盘 —— 日记 / 数据看板 / 五毛钱特效",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "e2e": "playwright test",
    "shots": "playwright test e2e/screenshots.spec.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
